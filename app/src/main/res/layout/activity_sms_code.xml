<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- En-tête CORRIGÉ -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Retour" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Validation SMS"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saisir le code:"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        android:text="Un code de validation a été envoyé par SMS"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCode"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8FAFC"
        app:layout_constraintTop_toBottomOf="@id/tvSubLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="____"
            android:letterSpacing="0.4"
            android:gravity="center"
            android:textColor="#4C3C75"
            android:textSize="26sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvCodeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(Simulé : saisissez le code)"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="italic"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp"
        android:background="#F1F5F9"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnValidate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnKey1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="2" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="3" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnKey4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="4" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey5" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="5" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey6" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="6" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnKey7" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="7" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey8" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="8" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey9" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="9" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <Button android:id="@+id/btnKeyClear" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="X" android:textSize="18sp" android:textStyle="bold" android:textColor="#EF4444" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKey0" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#334155" android:backgroundTint="#F8FAFC" app:cornerRadius="12dp" />
            <Button android:id="@+id/btnKeyDelete" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="⌫" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#EF4444" app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnValidate"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:text="VALIDER LE CODE"
        android:backgroundTint="#0F172A"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
